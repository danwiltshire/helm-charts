{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "httpWorkloads": {
      "additionalProperties": {
        "description": "Configuration for one named HTTP workload.",
        "properties": {
          "affinity": {
            "description": "Pod affinity rules; replaces the default anti-affinity.",
            "type": "object"
          },
          "annotations": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Deployment annotations.",
            "type": "object"
          },
          "args": {
            "description": "Container command arguments.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "env": {
            "description": "Container environment variables in Kubernetes EnvVar format.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "envFrom": {
            "description": "Container environment sources in Kubernetes EnvFromSource format.",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "image": {
            "anyOf": [
              {
                "required": [
                  "tag"
                ]
              },
              {
                "required": [
                  "digest"
                ]
              }
            ],
            "description": "Container image; specify a tag, a digest, or both.",
            "properties": {
              "digest": {
                "description": "SHA-256 container image digest.",
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "repository": {
                "description": "Container image repository.",
                "minLength": 1,
                "type": "string"
              },
              "tag": {
                "description": "Container image tag.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "repository"
            ],
            "type": "object"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Additional resource and pod labels; standard labels take precedence.",
            "type": "object"
          },
          "livenessProbe": {
            "description": "HTTP liveness probe overrides; defaults to /healthz/live.",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exec"
                  ]
                },
                {
                  "required": [
                    "tcpSocket"
                  ]
                },
                {
                  "required": [
                    "grpc"
                  ]
                }
              ]
            },
            "type": "object"
          },
          "nodeSelector": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Node labels required for scheduling.",
            "type": "object"
          },
          "partOf": {
            "description": "Application group label; defaults to the chart name.",
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
            "type": "string"
          },
          "podAnnotations": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Pod template annotations.",
            "type": "object"
          },
          "podSecurityContext": {
            "description": "Pod security context overrides.",
            "type": "object"
          },
          "port": {
            "description": "Container HTTP port.",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "readinessProbe": {
            "description": "HTTP readiness probe overrides; defaults to /healthz/ready.",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exec"
                  ]
                },
                {
                  "required": [
                    "tcpSocket"
                  ]
                },
                {
                  "required": [
                    "grpc"
                  ]
                }
              ]
            },
            "properties": {
              "httpGet": {
                "description": "HTTP request used for readiness checks.",
                "properties": {
                  "path": {
                    "description": "Readiness path; also used for the ALB health check.",
                    "pattern": "^/",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "replicas": {
            "description": "Number of replicas; defaults to 2.",
            "minimum": 1,
            "type": "integer"
          },
          "resources": {
            "description": "Container resource requests and limits.",
            "type": "object"
          },
          "securityContext": {
            "description": "Container security context overrides.",
            "type": "object"
          },
          "service": {
            "description": "ClusterIP Service settings.",
            "properties": {
              "annotations": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Service annotations; the ALB health-check path follows readiness.",
                "type": "object"
              },
              "enabled": {
                "description": "Create the Service; defaults to true.",
                "type": "boolean"
              },
              "port": {
                "description": "Service port; defaults to the container port.",
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "startupProbe": {
            "description": "HTTP startup probe overrides; disabled unless configured.",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "exec"
                  ]
                },
                {
                  "required": [
                    "tcpSocket"
                  ]
                },
                {
                  "required": [
                    "grpc"
                  ]
                }
              ]
            },
            "type": "object"
          },
          "tolerations": {
            "description": "Pod scheduling tolerations.",
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "image",
          "port"
        ],
        "type": "object"
      },
      "description": "Named stateless HTTP workloads.",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "required": []
      },
      "required": [],
      "title": "httpWorkloads",
      "type": "object"
    },
    "ingress": {
      "description": "yaml-language-server: $schema=values.schema.json\nALB ingress configuration.",
      "properties": {
        "domainName": {
          "default": "",
          "description": "Hostname for the ingress; empty permits hostless routing.",
          "title": "domainName",
          "type": "string"
        },
        "internetFacing": {
          "default": false,
          "description": "Use the internet-facing ALB ingress class instead of the internal class.",
          "title": "internetFacing",
          "type": "boolean"
        },
        "paths": {
          "description": "Routes to Services named with the Helm fullname convention.",
          "items": {
            "properties": {
              "path": {
                "description": "URL path to match.",
                "pattern": "^/",
                "type": "string"
              },
              "pathType": {
                "description": "Kubernetes path matching mode.",
                "enum": [
                  "Prefix",
                  "Exact",
                  "ImplementationSpecific"
                ],
                "type": "string"
              },
              "serviceName": {
                "description": "Workload key; the chart name uses the fullname as-is, other keys are appended.",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "type": "string"
              },
              "servicePort": {
                "description": "Port exposed by the Service.",
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "serviceName",
              "servicePort"
            ],
            "type": "object"
          },
          "minItems": 1,
          "title": "paths",
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "title": "ingress",
      "type": "object"
    }
  },
  "required": [
    "ingress",
    "httpWorkloads"
  ],
  "type": "object"
}