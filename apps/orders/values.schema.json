{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "api": {
      "properties": {
        "imageTag": {
          "default": "",
          "description": "Full image tag for the orders, catalog, and worker workloads, including the api- prefix.",
          "title": "imageTag",
          "type": "string"
        }
      },
      "required": [],
      "title": "api",
      "type": "object"
    },
    "awsSecrets": {
      "description": "AWS Secrets Manager secrets to synchronize; labels are Kubernetes Secret names.",
      "items": {
        "allOf": [
          {
            "if": {
              "properties": {
                "json": {
                  "const": false,
                  "required": []
                }
              },
              "required": [
                "json"
              ]
            },
            "required": [],
            "then": {
              "required": [
                "envName"
              ]
            }
          }
        ],
        "properties": {
          "envName": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "label": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "region": {
            "minLength": 1,
            "type": "string"
          },
          "secretName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "secretName",
          "region",
          "label",
          "json"
        ],
        "type": "object"
      },
      "title": "awsSecrets",
      "type": "array"
    },
    "domainName": {
      "default": "",
      "description": "Public hostname for the API ingress.",
      "title": "domainName",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "imageRepository": {
      "default": "426576223955.dkr.ecr.eu-west-2.amazonaws.com/orders",
      "description": "yaml-language-server: $schema=values.schema.json\nECR repository for the API and UI images.",
      "title": "imageRepository",
      "type": "string"
    },
    "postgresImage": {
      "default": "postgres:17-alpine@sha256:f9cf3e1f0066f0eb0c48707d864f0ac5941e9ff454a072077d97a4d278d07d73",
      "description": "PostgreSQL image, pinned to a multi-platform digest.",
      "title": "postgresImage",
      "type": "string"
    },
    "postgresStorage": {
      "default": "8Gi",
      "description": "PostgreSQL persistent volume size.",
      "title": "postgresStorage",
      "type": "string"
    },
    "rabbitmqImage": {
      "default": "rabbitmq:4-alpine@sha256:3dbd31cb9e4d45dac44de7b73cc45b848028494e98bcab71477386cbd4dc7f56",
      "description": "RabbitMQ image, pinned to a multi-platform digest.",
      "title": "rabbitmqImage",
      "type": "string"
    },
    "rabbitmqStorage": {
      "default": "2Gi",
      "description": "RabbitMQ persistent volume size.",
      "title": "rabbitmqStorage",
      "type": "string"
    },
    "ui": {
      "properties": {
        "imageTag": {
          "default": "",
          "description": "Full UI image tag, including the ui- prefix.",
          "title": "imageTag",
          "type": "string"
        }
      },
      "required": [],
      "title": "ui",
      "type": "object"
    }
  },
  "required": [],
  "type": "object"
}