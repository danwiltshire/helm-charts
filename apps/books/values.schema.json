{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "awsSecrets": {
      "description": "AWS Secrets Manager secrets to synchronize; labels are Kubernetes Secret names.",
      "items": {
        "allOf": [
          {
            "if": {
              "properties": {
                "json": {
                  "const": false,
                  "required": []
                }
              },
              "required": [
                "json"
              ]
            },
            "required": [],
            "then": {
              "required": [
                "envName"
              ]
            }
          }
        ],
        "properties": {
          "envName": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "label": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "region": {
            "minLength": 1,
            "type": "string"
          },
          "secretName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "secretName",
          "region",
          "label",
          "json"
        ],
        "type": "object"
      },
      "title": "awsSecrets",
      "type": "array"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "imageRepository": {
      "default": "426576223955.dkr.ecr.eu-west-2.amazonaws.com/books",
      "description": "yaml-language-server: $schema=values.schema.json",
      "title": "imageRepository",
      "type": "string"
    },
    "imageTag": {
      "default": "",
      "title": "imageTag",
      "type": "string"
    }
  },
  "required": [
    "imageRepository",
    "imageTag",
    "awsSecrets"
  ],
  "type": "object"
}