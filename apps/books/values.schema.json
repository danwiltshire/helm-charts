{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "awsSecrets": {
      "description": "AWS Secrets Manager secrets to synchronize; labels are Kubernetes Secret names.",
      "items": {
        "allOf": [
          {
            "if": {
              "properties": {
                "json": {
                  "const": false,
                  "required": []
                }
              },
              "required": [
                "json"
              ]
            },
            "required": [],
            "then": {
              "required": [
                "envName"
              ]
            }
          }
        ],
        "properties": {
          "envName": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "json": {
            "type": "boolean"
          },
          "label": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "type": "string"
          },
          "region": {
            "minLength": 1,
            "type": "string"
          },
          "secretName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "secretName",
          "region",
          "label",
          "json"
        ],
        "type": "object"
      },
      "title": "awsSecrets",
      "type": "array"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "webIngresses": {
      "description": "Ingresses; each routes to the Service `\u003cname\u003e-service` created by the web-workload library chart.",
      "items": {
        "properties": {
          "className": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "title": "webIngresses",
      "type": "array"
    },
    "webWorkloads": {
      "description": "Web workloads; each renders a Deployment, Service and PodDisruptionBudget.",
      "items": {
        "properties": {
          "arch": {
            "enum": [
              "arm64",
              "amd64"
            ],
            "type": "string"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "required": [],
            "type": "object"
          },
          "envFromSecrets": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "healthcheck": {
            "properties": {
              "livePath": {
                "type": "string"
              },
              "readyPath": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "image": {
            "properties": {
              "repository": {
                "minLength": 1,
                "type": "string"
              },
              "tag": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "repository",
              "tag"
            ],
            "type": "object"
          },
          "name": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "replicas": {
            "minimum": 2,
            "type": "integer"
          },
          "resources": {
            "required": [],
            "type": "object"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "type": "object"
      },
      "title": "webWorkloads",
      "type": "array"
    }
  },
  "required": [],
  "type": "object"
}